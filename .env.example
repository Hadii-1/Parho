# .env.example
# -----------------------------------------------------------------------------
# Copy this file to a new file named ".env" (same folder) and fill in the
# values. NEVER commit your real .env to GitHub — it holds your secret keys.
#
# NOTE: Parho also reads the .env one folder up (D:\Langchain Models\.env),
# so if your GROQ_API_KEY and GOOGLE_API_KEY already live there, you only need
# to set the NEW values below (SECRET_KEY and, if needed, MONGODB_URI).
# -----------------------------------------------------------------------------

# --- AI provider keys (you already have these in the parent .env) ---
GROQ_API_KEY=your-groq-key-here
GOOGLE_API_KEY=your-google-key-here

# --- Model names (optional; these are the defaults) ---
GROQ_MODEL=llama-3.1-8b-instant

# --- Embeddings ---
# Which embedding backend to use: "google" (cloud API, the default) or
# "huggingface" (local model). If you switch this, delete the chroma_db/ folder
# first — the two produce different-sized vectors that cannot be mixed.
EMBEDDING_PROVIDER=google
# Only used when EMBEDDING_PROVIDER=google:
EMBEDDING_MODEL=models/gemini-embedding-001

# --- MongoDB ---
# Local MongoDB default. For MongoDB Atlas (cloud) paste your connection string.
MONGODB_URI=mongodb://localhost:27017
DB_NAME=parho

# --- Security ---
# A long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# --- App rules ---
MAX_PDFS_PER_DAY=2

# --- CORS (only matters once the frontend is hosted separately) ---
# Comma-separated list of websites allowed to call this API from a browser.
# "*" = any site (easy for the first deploy). Lock it to your Vercel URL later:
#   ALLOWED_ORIGINS=https://parho.vercel.app
ALLOWED_ORIGINS=*
